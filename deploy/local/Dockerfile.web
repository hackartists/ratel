# syntax=docker/dockerfile:1.7
#
# Local-development image of the React web app (apps/web), built and run by
# `make local` (docker-compose profile `local`, see docs/local-docker.md).
#
# Same runtime as the k3s `web` pod (apps/web/Dockerfile: node serving
# dist/ through server/serve.mjs), but it builds the bundle itself so the
# host needs no Node/pnpm, and it proxies the API paths to the local API
# container (PROXY_API=1) because there is no ingress locally.
#
# Build context is the repository root, trimmed to the pnpm workspace by
# deploy/local/Dockerfile.web.dockerignore.

FROM node:22-bookworm AS build

WORKDIR /repo
RUN corepack enable

# Dependencies first so source edits don't reinstall them.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ts-bridges/package.json packages/ts-bridges/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY packages/ts-bridges packages/ts-bridges

# VITE_BYPASS=true matches the API image's `bypass` feature (identity
# verification is skipped). Firebase / WalletConnect / PortOne keys are
# optional locally; pass them as build args to exercise those flows.
ARG VITE_BYPASS=true
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_STORAGE_BUCKET=
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=
ARG VITE_FIREBASE_APP_ID=
ARG VITE_FIREBASE_MEASUREMENT_ID=
ARG VITE_WALLETCONNECT_PROJECT_ID=
ARG VITE_PORTONE_STORE_ID=
ARG VITE_PORTONE_INICIS_CHANNEL_KEY=
ENV VITE_BYPASS=${VITE_BYPASS} \
    VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY} \
    VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN} \
    VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID} \
    VITE_FIREBASE_STORAGE_BUCKET=${VITE_FIREBASE_STORAGE_BUCKET} \
    VITE_FIREBASE_MESSAGING_SENDER_ID=${VITE_FIREBASE_MESSAGING_SENDER_ID} \
    VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID} \
    VITE_FIREBASE_MEASUREMENT_ID=${VITE_FIREBASE_MEASUREMENT_ID} \
    VITE_WALLETCONNECT_PROJECT_ID=${VITE_WALLETCONNECT_PROJECT_ID} \
    VITE_PORTONE_STORE_ID=${VITE_PORTONE_STORE_ID} \
    VITE_PORTONE_INICIS_CHANNEL_KEY=${VITE_PORTONE_INICIS_CHANNEL_KEY}

RUN pnpm -C apps/web build

FROM node:22-alpine

WORKDIR /app
COPY --from=build /repo/apps/web/dist ./dist
COPY --from=build /repo/apps/web/server ./server

ENV PORT=3000 \
    NODE_ENV=production

EXPOSE 3000
USER node

CMD ["node", "server/serve.mjs"]
