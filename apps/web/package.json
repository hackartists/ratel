    "react-i18next": "^15.4.0",
    "react-dom": "18.3.1",
    "react-helmet-async": "1.3.0",
    "react-router-dom": "^6.28.1",
    "vite-react-ssg": "0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.5",
    "@types/node": "^22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.1.5",
